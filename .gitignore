# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtualenvs (uv default)
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pyright/

# Build artefacts
build/
dist/
site/
*.egg-info/
*.egg

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Capture artefacts (raw byte dumps + CSV exports from validation runs)
*.csv
*.csv.gz
*.ppk2.bin
# Test fixtures (tiny, committed for reproducibility)
!tests/fixtures/*.csv
!tests/fixtures/*.bin
# The captures of the validation round live on the branch `captures`;
# `just captures` puts them here.
/validation/evidence/*/captures/*.csv.xz

# Firmware hex artefacts: built locally (`just hex`) or by the CI
# firmware matrix. Never committed.
*.hex
