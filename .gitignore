!tests/fixtures/*.csv
!tests/fixtures/*.bin
# Committed reference captures (gzipped, lossless) for validation rounds
!validation/evidence/*/captures/*.csv.gz

# Firmware hex artefacts — built locally (`just hex`) and, later, by a
# CI build matrix. Never committed.
*.hex

# mkdocs build output
site/
