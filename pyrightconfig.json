{
    "include": ["src", "tests"],
    "strict": ["src", "tests"],
    "pythonVersion": "3.11",
    "pythonPlatform": "All",
    "venvPath": ".",
    "venv": ".venv",
    "reportMissingTypeStubs": "error",
    "reportImplicitOverride": "error",
    "reportUnnecessaryTypeIgnoreComment": "warning",
    "reportUnusedImport": "warning",
    "reportUnusedVariable": "warning"
}
