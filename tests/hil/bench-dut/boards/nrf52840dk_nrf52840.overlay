/*
 * nRF52840 DK (PCA10056) PPK2 bench-DUT pin assignment.
 *
 * P0.28 -> PPK2 D0 (5 Hz square wave)  : Arduino header A2
 * P0.29 -> PPK2 D1 (0.5 Hz square wave): Arduino header A3
 *
 * Both pins sit on the Arduino R3 analog header and are unclaimed
 * in the default board DTS: P0.29 appears only in the disabled spi0
 * pinctrl group ("cannot be used together with i2c0"); the enabled
 * spi1 uses P0.31/P0.30/P1.08. Same pin pair a sibling benchmark
 * validated for its energy-trace instrumentation (chosen there
 * after a PCA10056 schematic check).
 */

/ {
	ppk2_signals {
		compatible = "gpio-leds";

		ppk2_d0: ppk2_d0 {
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
			label = "PPK2 D0: 5 Hz";
		};

		ppk2_d1: ppk2_d1 {
			gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
			label = "PPK2 D1: 0.5 Hz";
		};
	};

	aliases {
		ppk2-d0 = &ppk2_d0;
		ppk2-d1 = &ppk2_d1;
	};
};
