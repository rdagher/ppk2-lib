/*
 * nRF52840 DK (PCA10056) PPK2 trace pins: P0.28 (A2) -> D0,
 * P0.29 (A3) -> D1. Same pair as firmware/bench-dut (Arduino R3
 * analog header; unclaimed by default-enabled peripherals).
 */
/ {
	zephyr,user {
		ppk2-d0-gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
		ppk2-d1-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
	};
};
