/*
 * nRF54LM20DK PPK2 trace pins: P1.12 -> D0, P1.13 -> D1.
 * Same pair as firmware/bench-dut (free of LED/button/UART duties;
 * on the GPIO_P1 header, so the PPK2 logic clips go straight on).
 */
/ {
	zephyr,user {
		ppk2-d0-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
		ppk2-d1-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
	};
};
